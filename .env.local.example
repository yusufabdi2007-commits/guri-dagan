# Supabase — required
# Find in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key — required for /book public endpoint
# Find in: Supabase Dashboard → Project Settings → API → service_role key (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Owner User ID — required for /book public endpoint
# Find in: Supabase Dashboard → Authentication → Users → your account UUID
OWNER_USER_ID=your_supabase_user_uuid_here

# Owner email — required so the app can sign in automatically with NO
# login screen. Use the same Supabase account as OWNER_USER_ID above.
# No password needed — the app mints a sign-in token server-side using
# SUPABASE_SERVICE_ROLE_KEY above. Server-side only, never exposed to the browser.
OWNER_EMAIL=your_supabase_account_email_here

# OpenAI — required for all AI features
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# YouTube Data API v3 — required for YouTube sync (/connections)
# Get from: Google Cloud Console → APIs & Services → Credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# App URL — used for push notifications
# Local: http://localhost:3010
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3010

# VAPID keys — required for Web Push notifications
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# WhatsApp bot (/api/whatsapp) — free-tier intake bot, Meta Cloud API direct.
# Get from: Meta for Developers → your app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
# Any string you choose — must match what you enter in Meta's webhook config
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_here

# Calendly booking link — currently unused by the WhatsApp bot (the August
# 2026 redesign replaced the booking-call step with a direct payment step —
# see HANDOFF.md "WhatsApp Bot" section). Left here in case it's wired back in.
CALENDLY_EVENT_URL=https://calendly.com/your-event-link-here

# Payment instructions shown by the WhatsApp bot after quoting a price —
# a Somali money-transfer number (EVC Plus/Zaad/etc.), not a card. Optional:
# without it, the bot just says Coach Rahma will share payment details directly.
PAYMENT_INFO_TEXT="Send payment via EVC Plus to +252-XX-XXXXXXX"

# Gemini API — used for the WhatsApp bot's advice replies (more natural
# Somali than the OpenAI/Groq models used elsewhere in this app).
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Shared secret for the external cron that triggers delayed WhatsApp
# replies (/api/whatsapp/send-pending). Optional but recommended — without
# it, that endpoint is unauthenticated. Any random string; must match what
# you put in the Authorization header of your cron job.
CRON_SECRET=choose_any_random_string_here
